# Configurações de E-mail para Envio de Orçamentos
# O formulário de solicitação de orçamento envia propostas diretamente para contato@arnaut.dev.br

NOTIFICATION_EMAIL=contato@arnaut.dev.br

# Opção 1: Envio via SMTP (Hostinger, Titan, Google Workspace, AWS SES, Brevo, Sendgrid, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@arnaut.dev.br
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM="Arnaut LTDA <contato@arnaut.dev.br>"

# Opção 2: Envio alternativo via Resend (se preferir API em vez de SMTP)
# RESEND_API_KEY=re_123456789
